# KYC reference app — `just backend` and `just frontend` are all you need.
# Each recipe sets up its own dependencies (venv / node_modules) on first run.

# List available recipes
default:
    @just --list

# Start backend + frontend together; Ctrl+C stops and cleans up both
dev:
    #!/usr/bin/env bash
    set -euo pipefail
    pgids=()
    cleanup() {
        trap - EXIT INT TERM
        for pgid in "${pgids[@]}"; do kill -TERM -- "-$pgid" 2>/dev/null || true; done
    }
    trap cleanup EXIT INT TERM
    run_in_group() { exec python3 -c 'import os, sys; os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])' "$@"; }
    run_in_group just backend & pgids+=($!)
    run_in_group just frontend & pgids+=($!)
    # if either half exits (e.g. backend setup fails), tear the other one down too
    # (polled rather than `wait -n`, which needs bash 4; macOS ships bash 3.2)
    while [ "$(jobs -r | wc -l)" -ge 2 ]; do sleep 1; done

# Start the backend API on :8000 (creates the venv and installs deps if needed)
backend:
    #!/usr/bin/env bash
    set -euo pipefail
    cd backend
    # platform-core needs Python >= 3.10; macOS still ships 3.9 as `python3`
    py=""
    for c in python3.13 python3.12 python3.11 python3.10 python3; do
        if command -v "$c" >/dev/null 2>&1 && "$c" -c 'import sys; sys.exit(sys.version_info < (3, 10))'; then
            py="$c"; break
        fi
    done
    if [ -z "$py" ]; then
        echo "error: need Python >= 3.10 on PATH (found $(python3 -V 2>&1)); e.g. brew install python@3.12" >&2
        exit 1
    fi
    if [ -d .venv ] && ! .venv/bin/python -c 'import sys; sys.exit(sys.version_info < (3, 10))'; then
        echo "recreating backend/.venv: it was built with $(.venv/bin/python -V 2>&1)"
        rm -rf .venv
    fi
    [ -d .venv ] || "$py" -m venv .venv
    # editable installs of pyproject-only packages need PEP 660 support (pip >= 21.3)
    .venv/bin/python -c 'import sys, pip; sys.exit(0 if tuple(map(int, pip.__version__.split(".")[:2])) >= (21, 3) else 1)' \
        || .venv/bin/pip install -q --upgrade pip
    .venv/bin/pip install -q -e ../../../platform/backend
    .venv/bin/pip install -q -e ".[dev]"
    .venv/bin/uvicorn server:app --reload --port 8000

# Start the frontend dev server on :5173 (installs npm deps if needed; proxies /api to :8000)
frontend:
    cd frontend && npm install --no-audit --no-fund
    cd frontend && npm run dev

# Run the backend test suite
test:
    cd backend && .venv/bin/pytest -q

# Lint + boundary checks for both halves
lint:
    cd backend && .venv/bin/ruff check . && .venv/bin/lint-imports
    cd frontend && npx eslint .
