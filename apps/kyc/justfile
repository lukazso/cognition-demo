# KYC reference app — `just backend` and `just frontend` are all you need.
# Each recipe sets up its own dependencies (venv / node_modules) on first run.

# List available recipes
default:
    @just --list

# Start the backend API on :8000 (creates the venv and installs deps if needed)
backend:
    cd backend && [ -d .venv ] || python3 -m venv .venv
    cd backend && .venv/bin/pip install -q -e ../../../platform/backend
    cd backend && .venv/bin/pip install -q -e ".[dev]"
    cd backend && .venv/bin/uvicorn server:app --reload --port 8000

# Start the frontend dev server on :5173 (installs npm deps if needed; proxies /api to :8000)
frontend:
    cd frontend && npm install --no-audit --no-fund
    cd frontend && npm run dev

# Run the backend test suite
test:
    cd backend && .venv/bin/pytest -q

# Lint + boundary checks for both halves
lint:
    cd backend && .venv/bin/ruff check . && .venv/bin/lint-imports
    cd frontend && npx eslint .
